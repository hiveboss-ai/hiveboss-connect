              "stop"
            ],
            "timeout": 5
          },
          {
            "type": "mcp_tool",
            "server": "plugin:hiveboss:hiveboss",
            "tool": "hook_stop",
            "input": {
              "session_id": "${session_id}",
              "cwd": "${cwd}",
              "prompt_id": "${prompt_id}",
              "stop_hook_active": "${stop_hook_active}"
            },
